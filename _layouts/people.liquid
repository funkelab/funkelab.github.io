---
layout: default
---
<div class="people">
  {% for status in page.person_status %}
    <a id="{{ status.id }}" href=".#{{ status.id }}">
      <h2 class="status">{{ status.text }}</h2>
    </a>
    {% assign filtered_people = page.people | where: "status", status.id %}
    {% assign grouped_people = filtered_people | group_by: "priority" %}
    <div class="row row-cols-1 row-cols-md-3">
      {% for group in grouped_people %}
        {% assign sorted_people = group["items"] | sort: "date_joined" %}
        {% for person in sorted_people %}
          {% include person.liquid %}
        {% endfor %}
      {% endfor %}
    </div>
  {% endfor %}
</div>
