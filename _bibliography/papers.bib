  booktitle = {Proceedings of the {{European Conference}} on {{Computer Vision}} ({{ECCV}}) {{Workshops}}},
  author = {Funke, Jan and Mais, Lisa and Champion, Andrew and Dye, Natalie and Kainmueller, Dagmar},
