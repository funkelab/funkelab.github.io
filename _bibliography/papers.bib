@inproceedings{jugOptimalJointSegmentation2014,
  title = {Optimal {{Joint Segmentation}} and {{Tracking}} of {{Escherichia Coli}} in the {{Mother Machine}}},
  booktitle = {Bayesian and {{grAphical Models}} for {{Biomedical Imaging}}},
  author = {Jug, Florian and Pietzsch, Tobias and Kainm{\"u}ller, Dagmar and Funke, Jan and Kaiser, Matthias and {van Nimwegen}, Erik and Rother, Carsten and Myers, Gene},
  editor = {Cardoso, M. Jorge and Simpson, Ivor and Arbel, Tal and Precup, Doina and Ribbens, Annemie},
  year = {2014},
  series = {Lecture {{Notes}} in {{Computer Science}}},
