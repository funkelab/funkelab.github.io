  title = {Physics-{{Informed Variational Autoencoder}} for {{Undersampled Fourier Ptychography}}},
  booktitle = {Imaging and {{Applied Optics Congress}} 2022 ({{3D}}, {{AOA}}, {{COSI}}, {{ISA}}, {{pcAOP}}) (2022), Paper {{CF1D}}.8},
